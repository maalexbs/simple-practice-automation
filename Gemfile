source 'https://rubygems.org'

gem 'rspec', '~> 3.12'             # Test runner and assertion library
gem 'capybara', '~> 3.39'         # High-level browser automation API
gem 'selenium-webdriver', '~> 4.18' # Selenium bindings for Capybara
gem 'faker', '~> 3.2'             # Dynamic test data generation (names, emails)
